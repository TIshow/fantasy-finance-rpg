{
  "name": "guild-market-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project engine",
    "test:watch": "vitest",
    "npc:generate": "tsx scripts/generate-npc-sheet.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test:db": "vitest run --project db",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "match:create": "tsx --env-file=.env scripts/create-match.ts",
    "postinstall": "prisma generate",
    "smoke": "tsx --env-file=.env scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
