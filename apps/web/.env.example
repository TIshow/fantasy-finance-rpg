# ---- ローカル開発（docker compose up -d の値） ----
DATABASE_URL=postgresql://gm:gm@localhost:5433/guild_market
# DB統合テスト用（npm run test:db が使う。中身は毎回作り直す）
TEST_DATABASE_URL=postgresql://gm:gm@localhost:5433/guild_market_test
# 1インスタンスあたりの接続数（サーバーレスでは小さく保つ）
DATABASE_POOL_MAX=3

# ---- 本番（Supabase東京 + Vercel hnd1）----
# 本番の値はこのファイルに書かない。Vercelの環境変数と、手元の .env.prod（コミットしない）に置く。
# Supabaseのダッシュボード上部の Connect → Session pooler / Transaction pooler の文字列を使う。
# 直結ホスト db.<ref>.supabase.co はIPv6専用で、IPv4の環境からつながらない。
#
# アプリの実行時（Vercel）：トランザクションモード（6543番）
#   DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# マイグレーション（npm run db:deploy:prod）：セッションモード（5432番）。.env.prod にだけ書く
#   DIRECT_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# DIRECT_URL をローカルの .env に書かないこと。Prisma の CLI は DATABASE_URL だけを見る。
